{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "settings-window",
  "description": "Settings / onboarding window. No pixel access, no export.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-hide",
    "allow-get-settings",
    "allow-update-settings",
    "allow-preview-filename",
    "allow-browse-save-directory",
    "allow-get-app-info",
    "allow-begin-capture",
    "allow-request-permission",
    "allow-open-permission-settings",
    "allow-quit-app"
  ]
}
